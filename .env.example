# Backend Server Configuration
# The backend server proxies API calls to TMDB and DeepSeek
VITE_BACKEND_URL=http://localhost:3001

# TMDB Image CDN (used for direct image loading)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Note: API keys are no longer needed in the frontend
# They should be configured in the backend server's .env file